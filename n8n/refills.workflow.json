      "id": "1a2b3c4d-0009-4e5f-8a9b-0c1d2e3f4a09",
      "name": "Read temperatures",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        480,
        80
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "onError": "continueRegularOutput",
      "notes": "Filled by the workflow Daily max temperature. Without that table the temperature list is empty."
    },
    {
      "parameters": {
        "jsCode": "// ?days=N: refills and daily max temperatures of the last N days including today (default 30, 1-400),\n// newest refills first. Days start at midnight in the workflow's timezone (Settings > Timezone; by\n// default the instance's GENERIC_TIMEZONE).\nconst q = $('Webhook').first().json.query || {};\nconst n = parseInt(q.days, 10);\nconst days = Number.isFinite(n) ? Math.min(Math.max(n, 1), 400) : 30;\nconst start = $now.startOf('day').minus({ days: days - 1 });\nconst from = start.toISODate();\nconst fromMs = start.toMillis();\nconst items = $('Read refills').all()\n  .map((i) => i.json)\n  .filter((r) => r.id != null && new Date(r.time).getTime() >= fromMs)  // an empty table gives one empty item\n  .map((r) => ({ id: r.id, time: r.time, bags: r.bags }))\n  .sort((a, b) => new Date(b.time) - new Date(a.time) || b.id - a.id);\n// Daily max temperature from the day `from` on, oldest day first\nconst temps = new Map();\nfor (const { json: r } of $input.all()) {\n  const date = String(r.date ?? '').slice(0, 10);\n  if (/^\\d{4}-\\d\\d-\\d\\d$/.test(date) && date >= from && r.tmax != null && Number.isFinite(Number(r.tmax)))\n    temps.set(date, Number(r.tmax));\n}\nconst temperature = [...temps].sort((a, b) => (a[0] < b[0] ? -1 : 1)).map(([date, tmax]) => ({ date, tmax }));\nreturn [{ json: { from, days, items, temperature } }];"
      },
      "id": "1a2b3c4d-0002-4e5f-8a9b-0c1d2e3f4a02",
      "name": "Build list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        80
      ]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {
          "responseCode": 200
        }
      },
      "id": "1a2b3c4d-0003-4e5f-8a9b-0c1d2e3f4a03",
      "name": "Reply: list",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Body: { \"time\": \"2026-11-01T13:14:00.000Z\", \"bags\": 2 }\nconst b = $input.first().json.body || {};\nconst time = typeof b.time === 'string' ? new Date(b.time) : new Date(NaN);\nconst bags = typeof b.bags === 'string' && /^\\s*\\d+\\s*$/.test(b.bags) ? Number(b.bags) : b.bags;\nlet error = '';\nif (isNaN(time)) error = 'time: missing or not a valid time (ISO 8601)';\nelse if (time.getTime() > Date.now() + 24 * 3600 * 1000) error = 'time: more than a day in the future';\nelse if (!Number.isInteger(bags) || bags < 1 || bags > 100) error = 'bags: a whole number from 1 to 100';\nreturn [{ json: error ? { ok: false, error } : { ok: true, time: time.toISOString(), bags } }];"
      },
      "id": "1a2b3c4d-0004-4e5f-8a9b-0c1d2e3f4a04",
